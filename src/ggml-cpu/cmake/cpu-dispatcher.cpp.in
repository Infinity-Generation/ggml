// Auto-generated by CMake configure_file from cpu-dispatcher.cpp.in.
// Static multi-variant CPU backend dispatcher.
//
// In GGML_CPU_ALL_VARIANTS_STATIC mode, multiple CPU-backend variants
// (haswell, skylakex, icelake, ...) are statically linked into ggml. Each
// variant exposes a tag-suffixed pair:
//
//     ggml_backend_reg_t ggml_backend_cpu_reg_<tag>(void);
//     int                ggml_backend_cpu_x86_score_<tag>(void);
//
// This TU provides the unmangled ggml_backend_cpu_reg() that
// ggml-backend-reg.cpp calls. On first invocation it picks the highest-
// scoring supported variant for the running CPU and caches the result.
//
// The variant table is populated at CMake configure time from the
// GGML_CPU_STATIC_VARIANT_TARGETS global property.

#include "ggml-backend.h"
#include "ggml-backend-impl.h"
#include "ggml-cpu.h"

#include <cstddef>

extern "C" {

// ---------------------------------------------------------------------------
// Per-variant entry-point forward declarations (CMake-generated).
// ---------------------------------------------------------------------------
@GGML_CPU_DISPATCHER_FORWARD_DECLS@

// ---------------------------------------------------------------------------
// Per-variant public-API forward declarations. Each variant defines these
// renamed via the prefix header (ggml_backend_cpu_init_<tag>, etc.). The
// dispatcher forwards the unmangled name to the chosen variant.
// ---------------------------------------------------------------------------
@GGML_CPU_DISPATCHER_PUBLIC_FORWARDS@

} // extern "C"

namespace {

struct cpu_variant {
    const char *       tag;
    int             (* score)(void);
    ggml_backend_reg_t (* reg)(void);
    // Public-API forwarders (one set of function pointers per variant).
    ggml_backend_t  (* init)(void);
    void            (* set_n_threads)(ggml_backend_t, int);
    void            (* set_threadpool)(ggml_backend_t, ggml_threadpool_t);
    void            (* set_abort_callback)(ggml_backend_t, ggml_abort_callback, void *);
    void            (* set_use_ref)(ggml_backend_t, bool);
    // CPU feature query forwarders (declared in ggml-cpu.h, called by external
    // consumers like stable-diffusion). These return per-variant compile-time
    // constants; the dispatcher reports the values for the chosen variant.
    int  (* has_avx)(void);
    int  (* has_avx_vnni)(void);
    int  (* has_avx2)(void);
    int  (* has_avx512)(void);
    int  (* has_avx512_vbmi)(void);
    int  (* has_avx512_vnni)(void);
    int  (* has_avx512_bf16)(void);
    int  (* has_amx_int8)(void);
    int  (* has_bmi2)(void);
    int  (* has_fma)(void);
    int  (* has_f16c)(void);
    int  (* has_sse3)(void);
    int  (* has_ssse3)(void);
    int  (* has_neon)(void);
    int  (* has_arm_fma)(void);
    int  (* has_fp16_va)(void);
    int  (* has_dotprod)(void);
    int  (* has_sve)(void);
    int  (* has_matmul_int8)(void);
    int  (* has_sme)(void);
    int  (* has_riscv_v)(void);
    int  (* has_vsx)(void);
    int  (* has_vxe)(void);
    int  (* has_wasm_simd)(void);
    int  (* has_llamafile)(void);
    int  (* get_rvv_vlen)(void);
    int  (* get_sve_cnt)(void);
};

// Variants are listed in declaration order; the dispatcher picks by max score.
// (Score comparison is total — a higher-tier variant returning 0 means its
// required CPU features are absent, so a lower-tier variant naturally wins.)
constexpr cpu_variant variants[] = {
@GGML_CPU_DISPATCHER_TABLE_ENTRIES@
};

constexpr size_t num_variants = sizeof(variants) / sizeof(variants[0]);

const cpu_variant * pick_variant(void) {
    const cpu_variant * best       = nullptr;
    int                 best_score = 0;
    for (size_t i = 0; i < num_variants; ++i) {
        const int s = variants[i].score();
        if (s > best_score) {
            best_score = s;
            best       = &variants[i];
        }
    }
    return best;
}

const cpu_variant * chosen_variant(void) {
    // Magic-statics give us thread-safe lazy first-call init (C++11+).
    static const cpu_variant * v = pick_variant();
    return v;
}

} // namespace

extern "C" {

ggml_backend_reg_t ggml_backend_cpu_reg(void) {
    const cpu_variant * v = chosen_variant();
    return v ? v->reg() : nullptr;
}

ggml_backend_t ggml_backend_cpu_init(void) {
    const cpu_variant * v = chosen_variant();
    return v ? v->init() : nullptr;
}

bool ggml_backend_is_cpu(ggml_backend_t backend) {
    if (!backend) return false;
    // Compare the backend's reg with the chosen variant's reg.
    const cpu_variant * v = chosen_variant();
    return v && backend->device && ggml_backend_dev_backend_reg(backend->device) == v->reg();
}

void ggml_backend_cpu_set_n_threads(ggml_backend_t backend, int n_threads) {
    const cpu_variant * v = chosen_variant();
    if (v) v->set_n_threads(backend, n_threads);
}

void ggml_backend_cpu_set_threadpool(ggml_backend_t backend, ggml_threadpool_t threadpool) {
    const cpu_variant * v = chosen_variant();
    if (v) v->set_threadpool(backend, threadpool);
}

void ggml_backend_cpu_set_abort_callback(ggml_backend_t backend, ggml_abort_callback abort_cb, void * data) {
    const cpu_variant * v = chosen_variant();
    if (v) v->set_abort_callback(backend, abort_cb, data);
}

void ggml_backend_cpu_set_use_ref(ggml_backend_t backend, bool use_ref) {
    const cpu_variant * v = chosen_variant();
    if (v) v->set_use_ref(backend, use_ref);
}

// CPU feature query forwarders. Each returns the chosen variant's compile-
// time const (or 0 if no variant matched, which shouldn't happen — every
// build registers at least the x64 baseline whose score is always >= 1).
#define GGML_CPU_QUERY_FWD(name) \
    int name(void) { const cpu_variant * v = chosen_variant(); return v ? v->name##_fn() : 0; }

// We can't macro-stamp these because the table member name (`has_avx`) and
// the public function (`ggml_cpu_has_avx`) don't share a stem. Hand-write.
int ggml_cpu_has_avx(void)         { const cpu_variant * v = chosen_variant(); return v ? v->has_avx()         : 0; }
