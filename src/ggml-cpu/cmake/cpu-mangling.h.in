// Auto-generated per CPU variant via CMake configure_file.
// VARIANT TAG: @GGML_CPU_VARIANT_TAG@
//
// In static multi-variant mode (GGML_CPU_ALL_VARIANTS_STATIC=ON), every
// CPU-backend variant (haswell, skylakex, icelake, ...) compiles the same
// source TUs with different /arch flags into a single binary. To avoid
// duplicate-symbol link errors, every strong-external symbol defined in those
// TUs is renamed via this prefix header (force-included via /FI on MSVC and
// -include on Clang/GCC).
//
// The dispatcher TU (cpu-dispatcher.cpp, generated alongside this header)
// declares the per-variant ggml_backend_cpu_reg_<tag>() and
// ggml_backend_cpu_x86_score_<tag>() entry points by their mangled names,
// picks the highest-scoring supported variant at first call, and re-exposes
// it through the unmangled ggml_backend_cpu_reg() that ggml-backend-reg.cpp
// expects.
//
// Maintenance: this list mirrors all top-level non-static function
// definitions across the variant TUs. New ggml_* symbols added to the CPU
// backend MUST be appended here or the static-multi-variant build will
// surface duplicate-symbol errors at link time pointing directly at the
// missing name.

#ifndef GGML_CPU_MANGLING_@GGML_CPU_VARIANT_TAG@_H
#define GGML_CPU_MANGLING_@GGML_CPU_VARIANT_TAG@_H

#define GGML_CPU_MANGLE_TAG @GGML_CPU_VARIANT_TAG@

#define GGML_CPU_MANGLE_CAT_(a, b) a##_##b
#define GGML_CPU_MANGLE_CAT(a, b)  GGML_CPU_MANGLE_CAT_(a, b)
#define GGML_CPU_MANGLE(name)      GGML_CPU_MANGLE_CAT(name, GGML_CPU_MANGLE_TAG)

// =============================================================================
// Backend entry points (called from outside the variant — registry + dispatcher)
// =============================================================================
#define ggml_backend_cpu_reg                       GGML_CPU_MANGLE(ggml_backend_cpu_reg)
#define ggml_backend_cpu_x86_score                 GGML_CPU_MANGLE(ggml_backend_cpu_x86_score)
#define ggml_backend_cpu_init                      GGML_CPU_MANGLE(ggml_backend_cpu_init)
#define ggml_backend_is_cpu                        GGML_CPU_MANGLE(ggml_backend_is_cpu)
#define ggml_backend_cpu_set_n_threads             GGML_CPU_MANGLE(ggml_backend_cpu_set_n_threads)
#define ggml_backend_cpu_set_threadpool            GGML_CPU_MANGLE(ggml_backend_cpu_set_threadpool)
#define ggml_backend_cpu_set_abort_callback        GGML_CPU_MANGLE(ggml_backend_cpu_set_abort_callback)
#define ggml_backend_cpu_set_use_ref               GGML_CPU_MANGLE(ggml_backend_cpu_set_use_ref)
#define ggml_backend_cpu_get_extra_buffer_types    GGML_CPU_MANGLE(ggml_backend_cpu_get_extra_buffer_types)
#define ggml_backend_cpu_hbm_buffer_type           GGML_CPU_MANGLE(ggml_backend_cpu_hbm_buffer_type)
#define ggml_backend_cpu_repack_buffer_type        GGML_CPU_MANGLE(ggml_backend_cpu_repack_buffer_type)
#define ggml_backend_amx_buffer_type               GGML_CPU_MANGLE(ggml_backend_amx_buffer_type)

// =============================================================================
// Public API (called by user code through ggml-cpu.h — must be reachable
// through the unmangled name; the dispatcher does NOT re-export these)
//
// These functions are NOT renamed because they're declared in installed
// headers that external consumers include. The variant compiles them but the
// final ggml.{lib,so} should expose exactly one definition. Currently we
// resolve this by letting ALL variants define them and relying on the linker
// to pick one (multiple defs would error). The proper fix is moving them to
// ggml-base or having the dispatcher forward them — TODO. For now, force them
// to be defined only by the lowest-baseline variant via per-variant guards.
// =============================================================================
// (intentionally left without redefinition; see TODO above)

